# Copy to your shell or hosting environment. All are optional.
CONTACT=you@example.com        # sent in the User-Agent; VBB asks for contact details
PORT=3000
# RADAR=off                    # only use the official VBB feeds
# COMMUNITY_API=https://v6.vbb.transport.rest
# GTFS_RT_URL=https://production.gtfsrt.vbb.de/data
# PHOTON_URL=https://photon.komoot.io
# WALK_ROUTER_URL=https://routing.openstreetmap.de/routed-foot
# ADMIN_TOKEN=change-me-to-a-long-random-secret   # needed to open /admin on a server (openssl rand -hex 24)
# TRUST_PROXY=1                 # behind Render/Fly/Netlify: count visitors by their real address
