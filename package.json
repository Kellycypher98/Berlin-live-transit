{
  "name": "berlin-live-transit",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Live map of Berlin public transport from the VBB timetable and realtime delays",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "node dev.mjs",
    "build": "npm --prefix client run build",
    "start": "node server.js",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^1.1.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "yauzl": "^3.1.3"
  }
}
